<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="طلب دفع جديد"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#00695C"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="رقم محفظتك (اللي هيتحول عليها الفلوس):"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etMerchantPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="01xxxxxxxxx"
            android:inputType="phone"
            android:textDirection="ltr"
            android:gravity="start" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="رقم محفظة العميل:"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etCustomerPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="01xxxxxxxxx"
            android:inputType="phone"
            android:textDirection="ltr"
            android:gravity="start" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="المبلغ (جنيه):"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0.00"
            android:inputType="numberDecimal"
            android:textDirection="ltr"
            android:gravity="start" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="بيان الطلب (اختياري):"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="مثال: فاتورة رقم 123" />

        <Button
            android:id="@+id/btnSendSms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="إرسال طلب الدفع SMS للعميل" />

        <Button
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مشاركة الطلب (واتساب وغيره)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="الطلبات الأخيرة:"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="#F5F5F5"
            android:text="لا توجد طلبات بعد"
            android:textSize="14sp"
            android:textDirection="ltr" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="13sp"
            android:textColor="#666666"
            android:text="عند وصول دفعة بنفس رقم العميل والمبلغ، يتم تعليم الطلب «مدفوع» تلقائياً ويصلك إشعار تأكيد." />
    </LinearLayout>
</ScrollView>
